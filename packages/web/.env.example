# Verified flow generation checks project/browser/auth readiness before starting a
# provider. External browser projects require an explicit non-production target;
# leave this blank only when the selected project is local-chromium.
PLAYWRIGHT_TEST_BASE_URL=
# Hosts with explicit dev/test/stage/qa/uat/sandbox/preview labels are classified automatically.
# For an unusually named reviewed non-production target, list the exact hostname here (no wildcards).
E2E_AUTH_ALLOWED_HOSTS=
# Auth-required specs must enable chromium-auth. The readiness check uses this
# resolved environment and does not fall back to ambient process settings.
E2E_AUTH_ENABLED=false
# With reuse enabled, E2E_AUTH_STATE_PATH must already be a regular non-symlink
# file. Otherwise E2E_USER_EMAIL/E2E_USER_PASSWORD and one success signal below
# are required before provider work can start.
E2E_AUTH_REUSE_STATE=false
E2E_AUTH_STATE_PATH=playwright/.auth/user.json
E2E_LOGIN_PATH=/login
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_LOGIN_EMAIL_SELECTOR=
E2E_LOGIN_PASSWORD_SELECTOR=
E2E_LOGIN_SUBMIT_SELECTOR=
E2E_AUTH_SUCCESS_SELECTOR=
E2E_AUTH_SUCCESS_URL_REGEX=
# HTTP basic auth for approved non-production hosts that sit behind a browser-level
# "system login" prompt. Set both or
# neither; values must never be committed.
E2E_HTTP_BASIC_USERNAME=
E2E_HTTP_BASIC_PASSWORD=
CI=

# Verified --dom-snapshot selector-discovery context has a fixed 64 KiB limit.
# It is intentionally not configurable, so there is no AI_AUTOHEAL_DOM_CONTEXT_MAX_BYTES setting.

# Nectar AI media-planner test data (fixtures/nectar-api.ts + fixtures/test-data-manager.ts).
# Pin the planningAI session the SKU suites seed via SET_SKUS (dataManager.ensurePlanningSession).
# Required for API-seeded SKU suites. Automatic creation is disabled because the captured API
# has no session-delete contract; use a disposable QA-owned plan-bearing session.
NECTAR_PLANNING_SESSION_ID=
# Exact non-production GraphQL hosts allowed to receive a bearer token when a caller passes an
# explicit base URL not already configured above. Comma-separated hostnames, no wildcards.
NECTAR_API_ALLOWED_HOSTS=
# Exact trusted MSAL issuer + tenant URLs allowed to receive the saved refresh token. Copy the
# token's verified `iss` value after confirming it with the environment owner; comma-separated.
NECTAR_AUTH_ALLOWED_ISSUERS=
# Local loopback only. Keep false for external environments.
NECTAR_ALLOW_INSECURE_HTTP=false
# Media names the four channel keys resolve to in admin_getEveryMedia (dev catalogue names vary;
# only used when a data case configures a channel limit via setChannelMaxHeroSkus).
E2E_MP_ONSITE_CHANNEL=
E2E_MP_OFFSITE_CHANNEL=
E2E_MP_ATHOME_CHANNEL=
E2E_MP_INSTORE_CHANNEL=
# Read-only rule expectations. The live preflight must match these values; leaving them blank uses
# the documented dev expectations (deadline 2, duration 20, store band 50-200).
E2E_MP_CHANNEL_BOOKING_DEADLINE_DAYS=
E2E_MP_CHANNEL_MIN_DURATION_DAYS=
E2E_MP_CHANNEL_MIN_STORES=
E2E_MP_CHANNEL_MAX_STORES=

# Exact channels for focused validation suites. The store-model names are required and must be
# distinct because generic labels such as "Cost per store" are not safe media identifiers.
E2E_MP_ONSITE_DISPLAY_BOOKING_DEADLINE_DAYS=
E2E_MP_DD_COMPETITION_PAGE_MIN_DURATION_DAYS=
E2E_MP_COST_PER_STORE_CHANNEL=
E2E_MP_COST_PER_UNIT_CHANNEL=
E2E_MP_BASE_RATE_CHANNEL=
E2E_MP_UNBOUNDED_CHANNEL=
E2E_MP_STORE_VOLUME_MIN=
E2E_MP_STORE_VOLUME_MAX=

# Exact channel identities for deletion/recompute flows.
E2E_MP_DELETION_ONSITE_CHANNEL=
E2E_MP_DELETION_OFFSITE_CHANNEL=
E2E_MP_RECOMPUTE_CHANNEL_A=
E2E_MP_RECOMPUTE_CHANNEL_B=

# Read-only channel/rate overrides for the pricing-cost suite. Leave blank to use the documented
# dev defaults. Before sending a plan, the suite reads admin_getMedia and fails closed unless the
# exact pricing model, rate, and managed-service fee match these values.
E2E_MP_TROLLEY_CHANNEL=
E2E_MP_TROLLEY_COST_PER_UNIT=
E2E_MP_TROLLEY_MS_PERCENT=
E2E_MP_PETROL_FLAT_CHANNEL=
E2E_MP_PETROL_COST_PER_UNIT=
E2E_MP_PETROL_MS_FLAT=
E2E_MP_TRAVELMONEY_CHANNEL=
E2E_MP_TRAVELMONEY_COST_PER_STORE=
E2E_MP_TRAVELMONEY_MS_PERCENT=
E2E_MP_BUDGETLED_CHANNEL=
E2E_MP_BUDGETLED_BUDGET=

# AI brain selection for test generation.
# If ANTHROPIC_API_KEY or OPENAI_API_KEY is set (real environment or this file),
# that API is used for AI calls. Otherwise the framework falls back to a locally
# installed `claude` or `codex` CLI. Variables already set in the real environment
# always win over values in this file. Run `npm run ai:brain:doctor` to see the
# selection and where each value came from (without printing key material).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# AI_BRAIN forces a specific brain instead of the automatic order above:
# auto|anthropic|openai|claude-cli|codex-cli (claude/codex are accepted aliases).
# A forced brain errors clearly when its key/binary is unavailable. Default: auto.
AI_BRAIN=
# Optional direct binary paths when a CLI is not resolvable through PATH or a
# supported common install location.
AI_BRAIN_CLAUDE_PATH=
AI_BRAIN_CODEX_PATH=
# CLI brains receive only a small runtime/provider-auth environment and execute
# from a disposable read-only directory. Cloud-specific CLI credentials (for
# example AWS Bedrock, Vertex AI, or Azure families) are not forwarded; use an
# existing CLI login or a REST brain for those routes.
# Model ids. Defaults: claude-opus-4-8 (Anthropic alias — canonical id, no date
# suffix) and gpt-4o-2024-11-20 (dated OpenAI snapshot, not the floating alias).
AI_ANTHROPIC_MODEL=
AI_OPENAI_MODEL=
# Optional Codex CLI model passed as `codex exec --model` and reported publicly.
# When accepted-result caching is enabled, the private cache identity combines
# the installed CLI version with this explicit model or the default-model label.
AI_CODEX_CLI_MODEL=
# Max output tokens per REST call. Default: 16000 each. Raise ANTHROPIC_MAX_TOKENS
# when generation fails with stop_reason=max_tokens (OPENAI_MAX_TOKENS for
# finish_reason=length).
ANTHROPIC_MAX_TOKENS=
OPENAI_MAX_TOKENS=
# Optional stage routes. Each stage inherits the global settings above unless its
# own non-empty override is set. Stages: SPEC_FIT, TEST_GENERATION,
# RECORDING_GENERATION, REPAIR, HEAL. Run `npm run ai:brain:doctor` to inspect the
# effective route and setting source for all five stages without exposing keys.
AI_SPEC_FIT_BRAIN=
AI_SPEC_FIT_ANTHROPIC_MODEL=
AI_SPEC_FIT_OPENAI_MODEL=
# Complete fit transport character budget: concise system contract, semantic
# flow-spec-draft/v2 suffix, CLI separator when applicable, and untrusted source.
# The human _template.md is not provider input. This stage setting takes
# precedence over AI_MAX_PROMPT_CHARS and is enforced before provider work.
AI_SPEC_FIT_MAX_PROMPT_CHARS=160000
AI_TEST_GENERATION_BRAIN=
AI_TEST_GENERATION_ANTHROPIC_MODEL=
AI_TEST_GENERATION_OPENAI_MODEL=
AI_RECORDING_GENERATION_BRAIN=
AI_RECORDING_GENERATION_ANTHROPIC_MODEL=
AI_RECORDING_GENERATION_OPENAI_MODEL=
AI_REPAIR_BRAIN=
AI_REPAIR_ANTHROPIC_MODEL=
AI_REPAIR_OPENAI_MODEL=
# Optional one-shot repair after a deterministic static-review failure. Disabled
# by default; runtime, environment, refusal, truncation, and conflict failures
# are never escalated. A repair sends only the prior source and bounded redacted
# reviewer diagnostics through the REPAIR stage route.
AI_REPAIR_ENABLED=false
# Refuse repair payloads above this byte budget before any provider request.
# The absolute safety ceiling is 2097152 bytes; keep the default conservative.
AI_REPAIR_MAX_SOURCE_BYTES=131072
AI_HEAL_BRAIN=
AI_HEAL_ANTHROPIC_MODEL=
AI_HEAL_OPENAI_MODEL=
# Opt-in auto-healing of committed tests that fail at runtime
# (npm run ai:test:heal -- --test <file>). Disabled by default: without the flag
# the healer refuses to modify any file. A heal is accepted only after the
# candidate passes AI_AUTOHEAL_VERIFY_RUNS consecutive runs with retries=0
# (flaky or skipped outcomes fail), and the original file is archived under
# .ai-runs/heal/<run-id>/ before promotion.
AI_AUTOHEAL_ENABLED=false
# Heal attempts per test before giving up, 1..10. Candidates rejected by the
# deterministic policy guard, typecheck, or static review also consume attempts.
AI_AUTOHEAL_MAX_ATTEMPTS=3
# Consecutive green runs required to accept a heal (2 or 3).
AI_AUTOHEAL_VERIFY_RUNS=2
# Refuse heal payloads above this byte budget before any provider request.
AI_AUTOHEAL_MAX_SOURCE_BYTES=131072
# Every stage also accepts provider token and OpenAI runtime overrides following
# this pattern: AI_<STAGE>_ANTHROPIC_MAX_TOKENS,
# AI_<STAGE>_OPENAI_MAX_TOKENS, AI_<STAGE>_PROMPT_CACHE,
# AI_<STAGE>_MAX_PROMPT_CHARS,
# AI_<STAGE>_OPENAI_REASONING_EFFORT, AI_<STAGE>_OPENAI_VERBOSITY, and
# AI_<STAGE>_OPENAI_SERVICE_TIER.
# REST output/prompt controls. Flow fitting still requires semantic JSON when
# provider-enforced schema mode is disabled, and Codex CLI always uses
# `--json --output-schema`. Compact prompting applies to Playwright REST calls.
AI_STRUCTURED_OUTPUT=true
AI_COMPACT_REST_PROMPT=true
# Provider-side prefix caching is opt-in and independent of AI_RESULT_CACHE.
# A stage-specific AI_<STAGE>_PROMPT_CACHE overrides this value. When enabled,
# Anthropic marks only the stable system prefix (TTL: 5m or 1h), and GPT-5.6
# uses an explicit stable-system breakpoint (TTL: 30m). CLI brains do not use
# these REST prompt-cache controls.
# With this false, GPT-5.6 is sent explicit mode without a breakpoint, disabling
# its implicit billable cache write. Older OpenAI models may still apply automatic
# provider caching to eligible prefixes even without an application routing key;
# use recorded cached-token metrics to confirm actual behavior.
AI_PROMPT_CACHE=false
ANTHROPIC_PROMPT_CACHE_TTL=5m
# Optional OpenAI routing-key override. Empty derives a stable, non-secret key from
# the selected model, system prefix, and output contract.
OPENAI_PROMPT_CACHE_KEY=
# Accepted-only exact Playwright cache under .ai-cache/generations for REST and
# Codex CLI (Claude CLI and flow fitting do not use it). A response stays in
# memory until the isolated candidate passes its one-repeat fast gate. Reuse also
# requires the verified current target to match the cached input or output state;
# unknown target state disables reuse and exact single-flight joining. Rejected or
# interrupted candidates are never persisted. Stored entries contain neither
# prompts nor API keys. Change the epoch to invalidate all semantic keys.
AI_RESULT_CACHE=true
AI_RESULT_CACHE_EPOCH=
# Provider-independent character budget for the actual system + task payload.
# Default: 200000 for REST and CLI; stage-specific overrides take precedence.
# Values must be whole numbers and cannot exceed the 2000000 hard safety ceiling.
# The canonical generation context inside this payload has its own deterministic
# 3500-character cap; this setting does not turn characters into token estimates.
AI_MAX_PROMPT_CHARS=200000
# GPT-5.6 defaults preserve the old non-reasoning code-generation behavior and
# minimize hidden/output tokens. Override only after quality evaluation.
OPENAI_REASONING_EFFORT=none
OPENAI_VERBOSITY=low
# Optional: auto|default|flex|priority. Flex can reduce asynchronous workload cost
# but may be slower; leave blank for the project/provider default.
OPENAI_SERVICE_TIER=
# Per-call timeout for REST and CLI brains, in milliseconds. Default: 120000.
AI_BRAIN_TIMEOUT_MS=
# AI_DOTENV_PATH overrides where the AI scripts look for this .env file. It is
# read from the real environment ONLY (setting it inside .env has no effect) and
# exists mainly for hermetic tests/CI. See `node scripts/ai/ai-doctor.mjs --help`.

# Allure reporting (enabled by default; set to false to disable the reporter).
ALLURE_ENABLED=true

# Front-end performance capture (Web Vitals + navigation/paint timing + chromium CDP).
# OPT-IN: collection runs ONLY when COLLECT_PERF=true. Unset (or any other value) => nothing is
# injected, nothing is collected/attached, and no performance/ report is written — ordinary runs are
# untouched. Set it to true for a perf run: per-test performance.json is written and attached, and the
# reporter aggregates all samples into PERF_OUTPUT_DIR.
COLLECT_PERF=false
# Directory (relative to packages/web) for the aggregated perf report
# (summary.json / samples.jsonl / summary.md). Default: performance.
PERF_OUTPUT_DIR=performance
