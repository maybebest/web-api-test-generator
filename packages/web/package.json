{
  "name": "playwright-aqa-web",
  "version": "1.0.0",
  "private": true,
  "description": "AI-assisted Playwright AQA framework for deterministic web automated testing.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint playwright.config.ts tests pages fixtures data automation --max-warnings=0",
    "fixture:start": "node local-fixture/server.mjs",
    "test:e2e": "playwright test",
    "test:e2e:local": "node scripts/ai/run-local-playwright.mjs",
    "test:e2e:list": "playwright test --list",
    "test:e2e:smoke": "playwright test tests/smoke --project=local-chromium",
    "test:e2e:regression": "node scripts/run-auth-regression.mjs",
    "test:e2e:accessibility": "playwright test tests/accessibility --project=local-chromium",
    "test:e2e:visual": "playwright test tests/visual --project=local-chromium",
    "test:e2e:recorded": "playwright test tests/recorded --project=local-chromium",
    "test:e2e:smoke:live": "node scripts/run-auth-readonly-smoke.mjs",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:trace": "playwright test --trace on",
    "test:e2e:report": "playwright show-report",
    "pw:install": "playwright install --with-deps",
    "pw:codegen": "playwright codegen",
    "ai:browser:install": "agent-browser install",
    "ai:browser:doctor": "agent-browser doctor --offline --quick",
    "ai:browser:skill": "node scripts/ai/agent-browser-skill.mjs",
    "ai:dom:discover": "node scripts/ai/dom-discover.mjs",
    "ai:dom:discover:review": "node scripts/ai/review-dom-discovery.mjs",
    "ai:spec:validate": "node scripts/ai/validate-flow-spec.mjs",
    "ai:spec:import": "node scripts/ai/import-spec.mjs",
    "ai:spec:drift": "node scripts/ai/check-spec-drift.mjs",
    "ai:spec:stamp": "node scripts/ai/stamp-spec-header.mjs",
    "ai:locators:audit": "node scripts/ai/audit-locators.mjs",
    "ai:recording:validate": "node scripts/ai/validate-recording.mjs",
    "ai:recording:normalize": "node scripts/ai/normalize-recording.mjs",
    "ai:recording:generate-test": "node scripts/ai/create-recording-generation-task.mjs",
    "ai:recording:review": "node scripts/ai/review-recorded-test.mjs",
    "ai:recording:gate": "node scripts/ai/recording-test-gate.mjs",
    "ai:recording:gate:fast": "node scripts/ai/recording-test-gate.mjs --repeat-each 1",
    "ai:recording:drift": "node scripts/ai/check-recording-drift.mjs",
    "ai:recording:gate:all": "node scripts/ai/recording-gate-all.mjs",
    "ai:recording:review:all": "node scripts/ai/recording-gate-all.mjs --review-only",
    "ai:generate-test": "node scripts/ai/create-generation-task.mjs",
    "ai:test:review": "node scripts/ai/review-generated-test.mjs",
    "ai:test:gate": "node scripts/ai/generated-test-gate.mjs",
    "ai:test:heal": "node scripts/ai/heal-test.mjs",
    "ai:test:gate:fast": "node scripts/ai/generated-test-gate.mjs --repeat-each 2",
    "ai:test:gate:all": "node scripts/ai/gate-all.mjs",
    "ai:test:gate:local-generated": "node scripts/ai/run-local-generated.mjs",
    "ai:test:review:all": "node scripts/ai/gate-all.mjs --review-only",
    "ai:test:ui:generated": "node scripts/ai/run-generated-ui.mjs",
    "ai:test:inventory": "node scripts/ai/generate-e2e-inventory.mjs",
    "ai:test:inventory:check": "node scripts/ai/generate-e2e-inventory.mjs --base-url https://www.dev.pollen.js-devops.co.uk/planning/nectar-ai --auth-verified --check",
    "ai:test:self": "node --test scripts/ai/__tests__/*.test.mjs",
    "ai:eval": "node scripts/ai/evals/golden-eval.mjs",
    "ai:mcp": "node scripts/ai/mcp-server.mjs",
    "ai:spec:catalog": "node scripts/ai/spec-catalog.mjs",
    "ai:clean:check": "node scripts/ai/check-clean-tree.mjs",
    "ai:clean:check:tracked": "node scripts/ai/check-clean-tree.mjs --tracked-only",
    "ai:brain:doctor": "node scripts/ai/ai-doctor.mjs",
    "ai:brain:generate:raw": "node scripts/ai/ai-generate.mjs",
    "ai:brain:generate": "node scripts/ai/verified-generate.mjs",
    "ai:tokens:report": "node scripts/ai/token-usage-report.mjs",
    "verify:static": "npm run typecheck && npm run lint && npm run ai:test:self && npm run ai:eval && npm run ai:clean:check:tracked && npm run ai:spec:validate -- --dir specs --strict && npm run ai:spec:drift && npm run ai:recording:validate -- --dir recordings && npm run ai:recording:drift",
    "verify:quality": "npm run verify:static && npm run ai:test:review:all && npm run ai:recording:review:all && npm run test:e2e:local && npm run ai:test:gate:local-generated && npm run ai:recording:gate:all",
    "ai:pw:help": "playwright --help",
    "ai:pw:show": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.59.1",
    "@types/node": "^24.9.1",
    "agent-browser": "0.27.0",
    "allure-commandline": "^2.42.1",
    "allure-playwright": "^3.10.0",
    "dotenv": "^17.2.3",
    "eslint": "9.39.5",
    "eslint-plugin-playwright": "2.10.5",
    "globals": "16.4.0",
    "js-yaml": "4.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.62.1",
    "web-vitals": "^5.3.0"
  }
}
