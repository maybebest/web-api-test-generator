# Copy this file to .env and fill in the values.
# Full description: docs/environment-variables.md

# --- required ---

# HTTP basic auth in front of the site
WEB_BASIC_AUTH_USER=
WEB_BASIC_AUTH_PASSWORD=

# Password shared by the agent pool
AGENT_PASSWORD=

# Administrator account (expert generation tests)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- optional (defaults in config/) ---

# Environment to run against: see config/environments.ts
# TEST_ENV=stage

# Agent logins the tests borrow from, comma separated
# AGENT_POOL_LOGINS=aqa1@gmail.com,aqa2@gmail.com,aqa3@gmail.com

# Test card
# TEST_CARD_NUMBER=4242424242424242
# TEST_CARD_EXPIRY=04/44
# TEST_CARD_CVC=444
# TEST_CARD_PAYMENT_METHOD_ID=pm_card_visa

# Generated user e-mails: <local>+<prefix><random>@<domain>
# TEST_EMAIL_LOCAL_PART=olekwer
# TEST_EMAIL_DOMAIN=gmail.com
