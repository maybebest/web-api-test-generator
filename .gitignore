# Root-level ignores for the workspaces monorepo.
# Per-suite ignores (reports, .env, dist/, .auth/, .calibration/, allure-*, etc.)
# live in packages/web/.gitignore and packages/api/.gitignore and still apply.
node_modules/
.DS_Store
.idea/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Belt-and-braces: the perf reporter anchors its output under packages/web, but ignore a stray
# root-level performance/ too (e.g. a custom PERF_OUTPUT_DIR or an old run).
/performance/
/playwright-report/
/test-results/
/.ai-runs/
# Root healer crash leftovers: exact hidden candidates and atomic promotion sources only.
/tests/**/.*.heal-*.candidate*.spec.ts
/tests-dev/**/.*.heal-*.candidate*.spec.ts
/tests/**/.*.spec.ts.*.promotion
/tests-dev/**/.*.spec.ts.*.promotion
/tmp/
/outputs/**/node_modules
/.worktrees/
/.env
